{
  "info": {
    "name": "PACT — Telemetry (temporary)",
    "description": "Temporary bearer-token telemetry query endpoint exposed by backend-elysia.\n\n**Setup:** set the collection variables `baseUrl`, `telemetryApiToken` (must equal the server's `TELEMETRY_API_TOKEN`) and `deviceId`. Auth is inherited from the collection, so every request sends `Authorization: Bearer {{telemetryApiToken}}` unless it explicitly overrides it.\n\n**Warning:** this endpoint is guarded by a single static token rather than a session and performs no organization scoping — any holder of the token can read any device.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{telemetryApiToken}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string",
      "description": "Server origin, no trailing slash."
    },
    {
      "key": "telemetryApiToken",
      "value": "",
      "type": "string",
      "description": "Must equal the server's TELEMETRY_API_TOKEN. Keep the real value in a Postman environment rather than committing it here."
    },
    {
      "key": "deviceId",
      "value": "ABC-DEF-1234",
      "type": "string",
      "description": "Device primary key, shaped XXX-XXX-XXXX."
    }
  ],
  "item": [
    {
      "name": "Queries",
      "item": [
        {
          "name": "Latest readings (defaults)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"]
            },
            "description": "Newest 100 readings for the device (limit=100, offset=0, order=desc)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('envelope shape', () => {",
                  "  pm.expect(body).to.have.all.keys('device', 'limit', 'offset', 'order', 'count', 'readings');",
                  "  pm.expect(body.readings).to.be.an('array').with.lengthOf(body.count);",
                  "});",
                  "pm.test('device block describes the requested device', () => {",
                  "  pm.expect(body.device).to.have.all.keys('id', 'modelName', 'latitude', 'longitude', 'mcc', 'mnc', 'organizationId', 'createdAt', 'updatedAt');",
                  "  pm.expect(body.device.id).to.eql(pm.collectionVariables.get('deviceId'));",
                  "  pm.expect(body.device.modelName).to.be.a('string');",
                  "});",
                  "pm.test('readings are newest first', () => {",
                  "  const times = body.readings.map((r) => Date.parse(r.createdAt));",
                  "  pm.expect(times).to.eql(times.slice().sort((a, b) => b - a));",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "200 OK",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "{{deviceId}}"]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"device\": {\n    \"id\": \"ABC-DEF-1234\",\n    \"modelName\": \"ABC-DEF\",\n    \"latitude\": 13.7563,\n    \"longitude\": 100.5018,\n    \"mcc\": 520,\n    \"mnc\": 3,\n    \"organizationId\": \"org_2t9x\",\n    \"createdAt\": \"2026-08-01T09:12:00.000Z\",\n    \"updatedAt\": \"2026-09-07T04:10:00.000Z\"\n  },\n  \"limit\": 100,\n  \"offset\": 0,\n  \"order\": \"desc\",\n  \"count\": 1,\n  \"readings\": [\n    {\n      \"id\": \"tz4a98xxat96iws9zmbrgj3a\",\n      \"deviceId\": \"ABC-DEF-1234\",\n      \"temperature\": 27.4,\n      \"humidity\": 68.2,\n      \"pressure\": 1008.3,\n      \"methane\": 412,\n      \"methaneRaw\": 1893,\n      \"carbonDioxide\": 615,\n      \"waterOffset\": 120,\n      \"waterDepth\": 342,\n      \"soilMoisture\": 41.7,\n      \"soilMoistureRaw\": 2104,\n      \"batteryPercentage\": 82.5,\n      \"batteryVoltage\": 3921,\n      \"status\": 0,\n      \"error\": 0,\n      \"createdAt\": \"2026-09-07T04:15:00.000Z\"\n    }\n  ]\n}"
            }
          ]
        },
        {
          "name": "Time range + paging",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}?from=2026-09-01T00:00:00Z&to=2026-09-07T00:00:00Z&limit=50&offset=0&order=asc",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"],
              "query": [
                {
                  "key": "from",
                  "value": "2026-09-01T00:00:00Z",
                  "description": "ISO 8601 datetime. Inclusive lower bound on created_at. Optional."
                },
                {
                  "key": "to",
                  "value": "2026-09-07T00:00:00Z",
                  "description": "ISO 8601 datetime. Inclusive upper bound on created_at. Optional."
                },
                {
                  "key": "limit",
                  "value": "50",
                  "description": "Integer 1-1000. Default 100."
                },
                {
                  "key": "offset",
                  "value": "0",
                  "description": "Integer >= 0. Default 0."
                },
                {
                  "key": "order",
                  "value": "asc",
                  "description": "asc | desc by created_at, id as tiebreaker. Default desc."
                }
              ]
            },
            "description": "Full parameter set. Page by holding the range fixed and advancing offset by limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('respects limit and order', () => {",
                  "  pm.expect(body.readings.length).to.be.at.most(50);",
                  "  pm.expect(body.order).to.eql('asc');",
                  "});",
                  "pm.test('readings fall inside the requested range', () => {",
                  "  const from = Date.parse('2026-09-01T00:00:00Z');",
                  "  const to = Date.parse('2026-09-07T00:00:00Z');",
                  "  body.readings.forEach((r) => {",
                  "    pm.expect(Date.parse(r.createdAt)).to.be.within(from, to);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
    },
    {
      "name": "Error cases",
      "item": [
        {
          "name": "401 — no Authorization header",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"]
            },
            "description": "Overrides collection auth to send no credentials."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));",
                  "pm.test('opaque message', () => pm.expect(pm.response.json().message).to.eql('Unauthorized'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "401 Unauthorized",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "{{deviceId}}"]
                }
              },
              "status": "Unauthorized",
              "code": 401,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"message\": \"Unauthorized\"\n}"
            }
          ]
        },
        {
          "name": "401 — invalid token",
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [
                { "key": "token", "value": "not-the-token", "type": "string" }
              ]
            },
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"]
            },
            "description": "A wrong token and a non-Bearer scheme both return the same opaque 401."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"
                ]
              }
            }
          ],
          "response": []
        },
        {
          "name": "400 — from after to",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}?from=2026-09-07T00:00:00Z&to=2026-09-01T00:00:00Z",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"],
              "query": [
                { "key": "from", "value": "2026-09-07T00:00:00Z" },
                { "key": "to", "value": "2026-09-01T00:00:00Z" }
              ]
            },
            "description": "The range is checked before the device lookup."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400 Bad Request', () => pm.response.to.have.status(400));",
                  "pm.test('explains the range', () => {",
                  "  pm.expect(pm.response.json().message).to.eql(\"Query parameter 'from' must be earlier than 'to'\");",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "400 Bad Request",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}?from=2026-09-07T00:00:00Z&to=2026-09-01T00:00:00Z",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "{{deviceId}}"],
                  "query": [
                    { "key": "from", "value": "2026-09-07T00:00:00Z" },
                    { "key": "to", "value": "2026-09-01T00:00:00Z" }
                  ]
                }
              },
              "status": "Bad Request",
              "code": 400,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"message\": \"Query parameter 'from' must be earlier than 'to'\"\n}"
            }
          ]
        },
        {
          "name": "404 — unknown device",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/ZZZ-ZZZ-0000",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "ZZZ-ZZZ-0000"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('404 Not Found', () => pm.response.to.have.status(404));",
                  "pm.test('message', () => pm.expect(pm.response.json().message).to.eql('Device not found'));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "404 Not Found",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/ZZZ-ZZZ-0000",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "ZZZ-ZZZ-0000"]
                }
              },
              "status": "Not Found",
              "code": 404,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"message\": \"Device not found\"\n}"
            }
          ]
        },
        {
          "name": "422 — limit out of range",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}?limit=99999",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"],
              "query": [{ "key": "limit", "value": "99999" }]
            },
            "description": "Elysia's query validation rejects limit > 1000 before the handler runs."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('422 Unprocessable Content', () => pm.response.to.have.status(422));",
                  "pm.test('names the offending property', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.on).to.eql('query');",
                  "  pm.expect(body.property).to.eql('limit');",
                  "});"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "422 Unprocessable Content",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}?limit=99999",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "{{deviceId}}"],
                  "query": [{ "key": "limit", "value": "99999" }]
                }
              },
              "status": "Unprocessable Content",
              "code": 422,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"type\": \"validation\",\n  \"on\": \"query\",\n  \"property\": \"limit\",\n  \"message\": \"Too big: expected number to be <=1000\",\n  \"found\": {\n    \"limit\": \"99999\"\n  }\n}"
            }
          ]
        },
        {
          "name": "503 — token not configured",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
              "host": ["{{baseUrl}}"],
              "path": ["telemetry", "devices", "{{deviceId}}"]
            },
            "description": "Returned to every caller — valid token or not — when the server has no TELEMETRY_API_TOKEN set. Reproduce by unsetting it and restarting the server; the endpoint fails closed rather than opening up."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('503 Service Unavailable', () => pm.response.to.have.status(503));"
                ]
              }
            }
          ],
          "response": [
            {
              "name": "503 Service Unavailable",
              "originalRequest": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{baseUrl}}/telemetry/devices/{{deviceId}}",
                  "host": ["{{baseUrl}}"],
                  "path": ["telemetry", "devices", "{{deviceId}}"]
                }
              },
              "status": "Service Unavailable",
              "code": 503,
              "_postman_previewlanguage": "json",
              "header": [{ "key": "Content-Type", "value": "application/json" }],
              "cookie": [],
              "body": "{\n  \"message\": \"Telemetry API token is not configured\"\n}"
            }
          ]
        }
      ]
    }
  ]
}
